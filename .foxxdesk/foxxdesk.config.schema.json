{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FoxxDesk configuration v6 — submodule-safe, read-only CI",
  "type": "object",
  "required": [
    "brand",
    "network",
    "icons",
    "rebrand",
    "upstream",
    "build",
    "github_actions",
    "safety"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 6,
      "description": "Versão do formato FoxxDesk. V6 mantém hbb_common upstream/limpo e usa CI somente leitura."
    },
    "brand": {
      "type": "object",
      "required": [
        "display_name",
        "slug",
        "company",
        "homepage"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "company": {
          "type": "string"
        },
        "maintainer_name": {
          "type": "string"
        },
        "maintainer_email": {
          "type": "string"
        },
        "homepage": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "network": {
      "type": "object",
      "required": [
        "server",
        "relay",
        "key"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "relay": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "icons": {
      "type": "object",
      "required": [
        "enabled",
        "source",
        "apply_on_prepare",
        "quality_profile"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "fallback_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_seed_missing_source": {
          "type": "boolean"
        },
        "apply_on_prepare": {
          "type": "boolean"
        },
        "discover_by_name": {
          "type": "boolean"
        },
        "create_brand_owned_assets": {
          "type": "boolean"
        },
        "quality_profile": {
          "enum": [
            "best",
            "balanced",
            "fast"
          ]
        },
        "min_source_size": {
          "type": "integer",
          "minimum": 64
        },
        "recommended_source_size": {
          "type": "integer",
          "minimum": 64
        },
        "padding_ratio": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.45
        },
        "ios_background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "update_ios_contents": {
          "type": "boolean"
        },
        "png_compress_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "png_optimize": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "rebrand": {
      "type": "object",
      "properties": {
        "profile": {
          "enum": [
            "safe",
            "runtime",
            "full"
          ]
        },
        "ci_profile": {
          "enum": [
            "safe",
            "runtime",
            "full"
          ]
        },
        "bootstrap_profile": {
          "enum": [
            "safe",
            "runtime",
            "full"
          ]
        },
        "scan_all": {
          "type": "boolean"
        },
        "remove_old_renamed": {
          "type": "boolean"
        },
        "patch_only": {
          "type": "boolean",
          "const": true
        },
        "replace_whole_source_files": {
          "type": "boolean",
          "const": false
        },
        "protect_upstream_names": {
          "type": "boolean"
        },
        "allow_internal_slug_change": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "upstream": {
      "type": "object",
      "properties": {
        "rustdesk_ref": {
          "type": "string"
        },
        "sync_hbb_common": {
          "type": "boolean"
        },
        "hbb_common_pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          }
        }
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object"
    },
    "github_actions": {
      "type": "object",
      "properties": {
        "manual_build_only": {
          "type": "boolean",
          "description": "FoxxDesk Build usa somente workflow_dispatch."
        },
        "prepare_only_manual_build_path": {
          "type": "boolean",
          "description": "Legado V3/V4. V5 não injeta prepare em workflows upstream."
        },
        "install_icon_dependencies": {
          "type": "boolean",
          "description": "Legado. V4 mantém false; CI não instala Pillow no Python do runner."
        },
        "deterministic_icon_cache_in_ci": {
          "type": "boolean",
          "description": "Restaura overlay autenticado por SHA-256 no CI em vez de regenerar imagens por SO."
        },
        "ci_mutates_source": {
          "type": "boolean",
          "description": "Deve permanecer false na V5. GitHub Actions apenas valida a árvore commitada."
        },
        "require_prepared_commit": {
          "type": "boolean",
          "description": "Exige que rebrand, hbb_common e assets tenham sido preparados e commitados antes do build."
        },
        "inject_prepare_hooks_into_upstream_workflows": {
          "type": "boolean",
          "const": false,
          "description": "V6 não injeta hooks em workflows upstream; o source deve ser preparado e commitado antes do build."
        }
      }
    },
    "safety": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
